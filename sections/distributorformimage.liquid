<div class="padding-global">
  <div class="container-large">
    <div class="padding-section-large">
      <div class="contact7_component">
        <div class="settings-schema w-embed"></div>

        <div class="w-layout-grid contact7_content">
          <!-- LEFT CONTENT -->
          <div class="contact7_content-left">
            <div class="margin-bottom margin-medium">
              <div class="contact7_heading-wrapper">
                <div class="margin-bottom margin-xsmall">
                  <div li-object="section.settings.contact_form_tagline_text" class="text-style-tagline">
                    {{ section.settings.contact_form_tagline_text }}
                  </div>
                </div>

                <div class="margin-bottom margin-small">
                  <h1 li-object="section.settings.contact_form_heading_text" class="heading-style-h2">
                    {{ section.settings.contact_form_heading_text }}
                  </h1>
                </div>

                <div class="richtext-wrapper text-size-medium w-richtext">
                  <p li-object="section.settings.contact_form_paragraph_text">
                    {{ section.settings.contact_form_paragraph_text }}
                  </p>
                </div>
              </div>
            </div>

            <!-- CONTACT FORM -->
            <div class="form_component">
              <div class="form6_block w-form">
                {% form 'contact', return_to: '/pages/thank-you', class: 'contact5_form' %}
                  <!-- Name fields -->
                  <div class="form_field-wrapper">
                    <label for="Form-6-First-Name-2" class="form_field-label">First and last name</label>
                    <div class="form6_field-group">
                      <input class="form_input w-input"
                             maxlength="256"
                             name="contact[first_name]"
                             placeholder="Enter your first name"
                             type="text"
                             id="Form-6-First-Name-2"
                             required>

                      <input class="form_input w-input"
                             maxlength="256"
                             name="contact[last_name]"
                             placeholder="Enter your last name"
                             type="text"
                             id="Form-6-Last-Name-2">
                    </div>
                  </div>

                  <!-- Company -->
                  <div class="form_field-wrapper">
                    <label for="Form-6-Company-Name-2" class="form_field-label">Company</label>
                    <div class="form6_field-group">
                      <input class="form_input w-input"
                             maxlength="256"
                             name="contact[company]"
                             placeholder="Enter your company name"
                             type="text"
                             id="Form-6-Company-Name-2"
                             required>
                    </div>
                  </div>

                  <!-- Phone + Email -->
                  <div class="form6_field-group">
                    <div class="form_field-wrapper">
                      <label for="Form-6-Phone-2" class="form_field-label">Phone Number</label>
                      <div class="form6_input-field">
                        <input class="form_input w-input"
                               maxlength="256"
                               name="contact[phone]"
                               placeholder="(07) 5678 1234"
                               type="tel"
                               id="Form-6-Phone-2"
                               required>
                      </div>
                    </div>

                    <div class="form_field-wrapper">
                      <label for="Form-6-Email-2" class="form_field-label">Email address</label>
                      <div class="form6_input-field">
                        <input class="form_input w-input"
                               maxlength="256"
                               name="contact[email]"
                               placeholder="your@email.com"
                               type="email"
                               id="Form-6-Email-2"
                               required>
                      </div>
                    </div>
                  </div>

                  <!-- Address -->
                  <div class="form_field-wrapper">
                    <label for="Form-6-Address-2" class="form_field-label">Business Address</label>
                    <input class="form_input w-input"
                           maxlength="256"
                           name="contact[address1]"
                           placeholder="123 Sample St, Brisbane QLD 4000"
                           type="text"
                           id="Form-6-Address-2">
                  </div>

                  <!-- Terms Checkbox -->
                  <div class="margin-bottom margin-small">
                    <label id="Contact-5-Checkbox" class="w-checkbox form_checkbox" name="contact[checkbox]">
                      <input type="checkbox"
                             id="Contact-CTA-Checkbox-2"
                             required
                             class="w-checkbox-input form_checkbox-icon">
                      <span class="form_checkbox-label text-size-tiny w-form-label">
                        I accept the
                        <a href="{{ shop.terms_of_service.url }}"
                           li-object:href="shop.terms_of_service.url"
                           class="text-style-link">Terms</a>
                      </span>
                    </label>
                  </div>

                  <!-- Submit -->
                  <input type="submit"
                         data-wait="Please wait..."
                         class="button w-button"
                         value="Submit">
                {% endform %}

                <!-- Success & Error -->
                <div class="form_message-success-wrapper w-form-done">
                  <div class="form_message-success">Thank you! Your submission has been received!</div>
                </div>
                <div class="form_message-error-wrapper w-form-fail">
                  <div class="form_message-error">Oops! Something went wrong while submitting the form.</div>
                </div>
              </div>
            </div>
          </div>

          <!-- RIGHT IMAGE -->
          <div class="contact7_image-wrapper">
            <img li-object:src="section.settings.contact_form_image | image_url: width: 720"
                 loading="lazy"
                 alt=""
                 src="{{ section.settings.contact_form_image | image_url: width: 720 }}"
                 class="contact7_image">
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "tag": "section",
  "name": "DistributorFormImage",
  "class": "section_contact7",
  "settings": [
    {
      "type": "header",
      "content": "Contact Content Settings"
    },
    {
      "type": "text",
      "id": "contact_form_tagline_text",
      "label": "Contact Tagline Text",
      "default": "Short tagline here"
    },
    {
      "type": "text",
      "id": "contact_form_heading_text",
      "label": "Contact Heading Text",
      "default": "Short heading here"
    },
    {
      "type": "richtext",
      "id": "contact_form_paragraph_text",
      "label": "Contact Paragraph Text",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.<\/p>"
    },
    {
      "type": "image_picker",
      "id": "contact_form_image",
      "label": "Contact Form Image"
    }
  ],
  "presets": [
    {
      "name": "DistributorFormImage",
      "category": "Liquify",
      "blocks": []
    }
  ]
}
{% endschema %}
