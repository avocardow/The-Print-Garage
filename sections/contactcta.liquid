<div id="contact" class="padding-global">
  <div class="container-large">
    <div class="padding-section-large">
      <div class="contact5_component">
        <div class="w-layout-grid contact5_content">
          <div class="settings-schema w-embed"></div>

          <div class="contact5_content-left">
            <div class="margin-bottom margin-medium">
              <div class="contact5_heading-wrapper">
                <div class="margin-bottom margin-small">
                  <h2 class="heading-style-h2">
                    {{ section.settings.contact_heading_text }}
                  </h2>
                </div>
                <div class="richtext-wrapper text-size-medium w-richtext">
                  {{ section.settings.contact_paragraph_text }}
                </div>
              </div>
            </div>

            <div class="contact5_contact-list">
              <div class="contact5_item">
                <div class="contact5_icon-wrapper">📞</div>
                <div>{{ shop.phone }}</div>
              </div>
              <div class="contact5_item">
                <div class="contact5_icon-wrapper">✉️</div>
                <div>{{ shop.email }}</div>
              </div>
              <div class="contact5_item">
                <div class="contact5_icon-wrapper">📍</div>
                <div>{{ shop.address.summary }}</div>
              </div>
            </div>
          </div>

          <div class="contact5_content-right">
            <script charset="utf-8" type="text/javascript" src="//js.hsforms.net/forms/embed/v2.js"></script>
            <script>
            hbspt.forms.create({
                portalId: "5189439",
                formId: "b0a716cc-071d-4122-a692-d99f213bc258",
                region: "na1"
            });
            </script>

            {% comment %} {% form 'contact', return_to: '/pages/thankyou', class: 'contact5_form' %}
              <div class="form_field-wrapper">
                <label for="Contact-5-Name-2" class="form_form_label">Name</label>
                <input class="form_input w-input"
                       maxlength="256"
                       name="contact[name]"
                       id="Contact-5-Name-2"
                       type="text"
                       required>
              </div>

              <div class="form_field-wrapper">
                <label for="Contact-5-Email-2" class="form_form_label">Email</label>
                <input class="form_input w-input"
                       maxlength="256"
                       name="contact[email]"
                       id="Contact-5-Email-2"
                       type="email"
                       required>
              </div>

              <div class="form_field-wrapper">
                <label for="Contact-5-Message-2" class="form_form_label">Message</label>
                <textarea class="form_input is-text-area w-input"
                          maxlength="5000"
                          name="contact[body]"
                          id="Contact-5-Message-2"
                          placeholder="Type your message..."
                          required></textarea>
              </div>

              <div class="margin-bottom margin-small">
                <label class="w-checkbox form_checkbox">
                  <input type="checkbox"
                         id="Contact-CTA-Checkbox-2"
                         required
                         class="w-checkbox-input form_checkbox-icon">
                  <span class="form_checkbox-label text-size-tiny w-form-label">
                    I accept the <a href="#" class="text-style-link">Terms</a>
                  </span>
                </label>
              </div>

              <input type="submit" value="Submit" class="button w-button">
            {% endform %} {% endcomment %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "tag": "section",
  "name": "ContactCTA",
  "class": "section_contact5",
  "settings": [
    {
      "type": "header",
      "content": "Contact CTA Content Settings"
    },
    {
      "type": "textarea",
      "id": "contact_heading_text",
      "label": "Contact CTA Heading Text",
      "default": "Medium length section heading goes here"
    },
    {
      "type": "richtext",
      "id": "contact_paragraph_text",
      "label": "Contact Paragraph Text",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.<\/p>"
    }
  ],
  "presets": [
    {
      "name": "ContactCTA",
      "category": "Liquify",
      "blocks": []
    }
  ]
}
{% endschema %}
