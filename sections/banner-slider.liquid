<!-- sections/banner-slider.liquid -->
<div class="banner-slider-wrapper">
  <div class="swiper bannerSwiper{{ section.id }}">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide">
          {% if block.settings.banner_image != blank %}
            <div class="slide-background">
              <img src="{{ block.settings.banner_image | image_url: width: 1920 }}" 
                   alt="{{ block.settings.banner_image.alt | escape }}"
                   loading="lazy">
            </div>
          {% endif %}
          <div class="slide-overlay"></div>
          <div class="slide-content">
            <div class="container">
              <div class="text-content">
                {% if block.settings.header != blank %}
                  <h1 class="slide-header">{{ block.settings.header }}</h1>
                {% endif %}
                {% if block.settings.description != blank %}
                  <p class="slide-description">{{ block.settings.description }}</p>
                {% endif %}
                {% if block.settings.button_text != blank and block.settings.button_link != blank %}
                  <a href="{{ block.settings.button_link }}" class="slide-button">
                    {{ block.settings.button_text }}
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    
    {% if section.blocks.size > 1 %}
      <!-- Navigation arrows -->
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
      
      <!-- Pagination dots -->
      <div class="swiper-pagination"></div>
    {% endif %}
  </div>
</div>

<!-- Swiper CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/8.4.7/swiper-bundle.min.css">

<style>
  .banner-slider-wrapper {
    width: 100%;
    height: {{ section.settings.slider_height }}px;
    position: relative;
    overflow: hidden;
  }

  .bannerSwiper{{ section.id }} {
    width: 100%;
    height: 100%;
  }

  .swiper-slide {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    background: linear-gradient(135deg, {{ section.settings.bg_color_1 }}, {{ section.settings.bg_color_2 }});
  }

  .slide-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .slide-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .slide-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 2;
  }

  .slide-content {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
  }

  .text-content {
    max-width: 600px;
    text-align: {{ section.settings.text_alignment }};
  }

  .slide-header {
    font-size: {{ section.settings.header_size }}px;
    font-weight: 900;
    color: {{ section.settings.header_color }};
    margin: 0 0 20px 0;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    animation: slideInUp 0.8s ease-out;
  }

  .slide-description {
    font-size: {{ section.settings.description_size }}px;
    color: {{ section.settings.description_color }};
    margin: 0 0 30px 0;
    line-height: 1.4;
    font-weight: 600;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
    animation: slideInUp 0.8s ease-out 0.2s both;
  }

  .slide-button {
    display: inline-block;
    background: linear-gradient(45deg, {{ section.settings.button_bg_1 }}, {{ section.settings.button_bg_2 }});
    color: {{ section.settings.button_text_color }};
    padding: 15px 40px;
    text-decoration: none;
    border-radius: {{ section.settings.button_radius }}px;
    font-weight: bold;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    border: none;
    cursor: pointer;
    animation: slideInUp 0.8s ease-out 0.4s both;
  }

  .slide-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
    filter: brightness(1.1);
  }

  /* Swiper Navigation Styling */
  .bannerSwiper{{ section.id }} .swiper-button-next,
  .bannerSwiper{{ section.id }} .swiper-button-prev {
    color: {{ section.settings.navigation_color }};
    background: rgba(255, 255, 255, 0.2);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
  }

  .bannerSwiper{{ section.id }} .swiper-button-next:after,
  .bannerSwiper{{ section.id }} .swiper-button-prev:after {
    font-size: 20px;
    font-weight: bold;
  }

  .bannerSwiper{{ section.id }} .swiper-button-next:hover,
  .bannerSwiper{{ section.id }} .swiper-button-prev:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: scale(1.1);
  }

  /* Pagination Styling */
  .bannerSwiper{{ section.id }} .swiper-pagination {
    bottom: 30px;
  }

  .bannerSwiper{{ section.id }} .swiper-pagination-bullet {
    background: rgba(255, 255, 255, 0.5);
    opacity: 1;
    width: 12px;
    height: 12px;
    margin: 0 6px;
    transition: all 0.3s ease;
  }

  .bannerSwiper{{ section.id }} .swiper-pagination-bullet-active {
    background: {{ section.settings.pagination_active_color }};
    transform: scale(1.2);
  }

  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .banner-slider-wrapper {
      height: {{ section.settings.mobile_height }}px;
    }

    .text-content {
      text-align: center;
      padding: 0 10px;
    }

    .slide-header {
      font-size: {{ section.settings.header_size | times: 0.7 }}px;
      margin-bottom: 15px;
    }

    .slide-description {
      font-size: {{ section.settings.description_size | times: 0.9 }}px;
      margin-bottom: 25px;
    }

    .slide-button {
      padding: 12px 30px;
      font-size: 14px;
    }

    .bannerSwiper{{ section.id }} .swiper-button-next,
    .bannerSwiper{{ section.id }} .swiper-button-prev {
      width: 40px;
      height: 40px;
    }

    .bannerSwiper{{ section.id }} .swiper-button-next:after,
    .bannerSwiper{{ section.id }} .swiper-button-prev:after {
      font-size: 16px;
    }
  }

  @media (max-width: 480px) {
    .banner-slider-wrapper {
      height: {{ section.settings.mobile_height | times: 0.8 }}px;
    }

    .slide-header {
      font-size: {{ section.settings.header_size | times: 0.6 }}px;
    }

    .slide-description {
      font-size: {{ section.settings.description_size | times: 0.8 }}px;
    }

    .container {
      padding: 0 15px;
    }
  }
</style>

<!-- Swiper JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/8.4.7/swiper-bundle.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const swiper{{ section.id }} = new Swiper('.bannerSwiper{{ section.id }}', {
      loop: {{ section.settings.loop }},
      autoplay: {% if section.settings.autoplay %}
        {
          delay: {{ section.settings.autoplay_speed }}000,
          disableOnInteraction: false,
        }
      {% else %}
        false
      {% endif %},
      speed: {{ section.settings.transition_speed }},
      effect: '{{ section.settings.transition_effect }}',
      {% if section.settings.transition_effect == 'fade' %}
      fadeEffect: {
        crossFade: true
      },
      {% endif %}
      navigation: {
        nextEl: '.bannerSwiper{{ section.id }} .swiper-button-next',
        prevEl: '.bannerSwiper{{ section.id }} .swiper-button-prev',
      },
      pagination: {
        el: '.bannerSwiper{{ section.id }} .swiper-pagination',
        clickable: true,
      },
      on: {
        slideChange: function () {
          // Re-trigger animations on slide change
          const activeSlide = this.slides[this.activeIndex];
          const textElements = activeSlide.querySelectorAll('.slide-header, .slide-description, .slide-button');
          textElements.forEach((el, index) => {
            el.style.animation = 'none';
            setTimeout(() => {
              el.style.animation = `slideInUp 0.8s ease-out ${index * 0.2}s both`;
            }, 50);
          });
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Full Width Banner Slider",
  "settings": [
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "range",
      "id": "slider_height",
      "min": 400,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Desktop Height",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 300,
      "max": 600,
      "step": 25,
      "unit": "px",
      "label": "Mobile Height",
      "default": 450
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Speed",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop Slides",
      "default": true
    },
    {
      "type": "select",
      "id": "transition_effect",
      "label": "Transition Effect",
      "options": [
        { "value": "slide", "label": "Slide" },
        { "value": "fade", "label": "Fade" }
      ],
      "default": "slide"
    },
    {
      "type": "range",
      "id": "transition_speed",
      "min": 300,
      "max": 1500,
      "step": 100,
      "unit": "ms",
      "label": "Transition Speed",
      "default": 600
    },
    {
      "type": "header",
      "content": "Background & Overlay"
    },
    {
      "type": "color",
      "id": "bg_color_1",
      "label": "Fallback Gradient Start",
      "default": "#8B5CF6"
    },
    {
      "type": "color",
      "id": "bg_color_2",
      "label": "Fallback Gradient End",
      "default": "#A855F7"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "%",
      "label": "Image Overlay Opacity",
      "default": 30
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "header_size",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Header Font Size",
      "default": 48
    },
    {
      "type": "color",
      "id": "header_color",
      "label": "Header Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size",
      "default": 18
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Button Styling"
    },
    {
      "type": "color",
      "id": "button_bg_1",
      "label": "Button Gradient Start",
      "default": "#F97316"
    },
    {
      "type": "color",
      "id": "button_bg_2",
      "label": "Button Gradient End",
      "default": "#EA580C"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Button Border Radius",
      "default": 25
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "color",
      "id": "navigation_color",
      "label": "Arrow Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "pagination_active_color",
      "label": "Active Dot Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "banner_image",
          "label": "Background Image"
        },
        {
          "type": "text",
          "id": "header",
          "label": "Header Text",
          "default": "FULL WRAP BOTTLE PRINTING"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description Text",
          "default": "WITH AN MOQ OF 15!"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Full Width Banner Slider",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}