<!-- sections/banner-slider.liquid -->
<div class="banner-slider-wrapper" id="bannerSlider{{ section.id }}">
  <div class="slider-container">
    <div class="slider-track" id="sliderTrack{{ section.id }}">
      {% for block in section.blocks %}
        <div class="slide {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}">
          {% if block.settings.banner_image != blank %}
            <div class="slide-background">
              <img src="{{ block.settings.banner_image | image_url: width: 1920 }}" 
                   alt="{{ block.settings.banner_image.alt | escape }}"
                   loading="lazy">
            </div>
          {% endif %}
          <div class="slide-overlay"></div>
          <div class="slide-content">
            <div class="container">
              <div class="text-content">
                {% if block.settings.header != blank %}
                  <h1 class="slide-header">{{ block.settings.header }}</h1>
                {% endif %}
                {% if block.settings.description != blank %}
                  <p class="slide-description">{{ block.settings.description }}</p>
                {% endif %}
                {% if block.settings.button_text != blank and block.settings.button_link != blank %}
                  <a href="{{ block.settings.button_link }}" class="slide-button">
                    {{ block.settings.button_text }}
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    
    {% if section.blocks.size > 1 %}
      <!-- Navigation arrows -->
      <button class="slider-nav prev" onclick="changeSlide{{ section.id }}(-1)" aria-label="Previous slide">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
        </svg>
      </button>
      <button class="slider-nav next" onclick="changeSlide{{ section.id }}(1)" aria-label="Next slide">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
        </svg>
      </button>
      
      <!-- Pagination dots -->
      <div class="slider-pagination" id="pagination{{ section.id }}">
        {% for block in section.blocks %}
          <button class="pagination-dot {% if forloop.first %}active{% endif %}" 
                  onclick="goToSlide{{ section.id }}({{ forloop.index0 }})" 
                  data-slide="{{ forloop.index0 }}"></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<style>
  .banner-slider-wrapper {
    width: 100%;
    height: {{ section.settings.slider_height }}px;
    position: relative;
    overflow: hidden;
  }

  .slider-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slider-track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s ease-in-out;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    background: linear-gradient(135deg, {{ section.settings.bg_color_1 }}, {{ section.settings.bg_color_2 }});
  }

  .slide.active {
    opacity: 1;
  }

  .slide-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .slide-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .slide-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 2;
  }

  .slide-content {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
  }

  .text-content {
    max-width: 600px;
    text-align: {{ section.settings.text_alignment }};
  }

  .slide.active .slide-header {
    animation: slideInUp 0.8s ease-out;
  }

  .slide.active .slide-description {
    animation: slideInUp 0.8s ease-out 0.2s both;
  }

  .slide.active .slide-button {
    animation: slideInUp 0.8s ease-out 0.4s both;
  }

  .slide-header {
    font-size: {{ section.settings.header_size }}px;
    font-weight: 900;
    color: {{ section.settings.header_color }};
    margin: 0 0 20px 0;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    opacity: 0;
  }

  .slide-description {
    font-size: {{ section.settings.description_size }}px;
    color: {{ section.settings.description_color }};
    margin: 0 0 30px 0;
    line-height: 1.4;
    font-weight: 600;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
    opacity: 0;
  }

  .slide-button {
    display: inline-block;
    background: linear-gradient(45deg, {{ section.settings.button_bg_1 }}, {{ section.settings.button_bg_2 }});
    color: {{ section.settings.button_text_color }};
    padding: 15px 40px;
    text-decoration: none;
    border-radius: {{ section.settings.button_radius }}px;
    font-weight: bold;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    border: none;
    cursor: pointer;
    opacity: 0;
  }

  .slide-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
    filter: brightness(1.1);
  }

  /* Navigation Styling */
  .slider-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.2);
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    color: {{ section.settings.navigation_color }};
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 10;
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slider-nav:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: translateY(-50%) scale(1.1);
  }

  .slider-nav.prev {
    left: 30px;
  }

  .slider-nav.next {
    right: 30px;
  }

  /* Pagination Styling */
  .slider-pagination {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    z-index: 10;
  }

  .pagination-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .pagination-dot.active,
  .pagination-dot:hover {
    background: {{ section.settings.pagination_active_color }};
    transform: scale(1.2);
  }

  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .banner-slider-wrapper {
      height: {{ section.settings.mobile_height }}px;
    }

    .text-content {
      text-align: center;
      padding: 0 10px;
    }

    .slide-header {
      font-size: {{ section.settings.header_size | times: 0.7 }}px;
      margin-bottom: 15px;
    }

    .slide-description {
      font-size: {{ section.settings.description_size | times: 0.9 }}px;
      margin-bottom: 25px;
    }

    .slide-button {
      padding: 12px 30px;
      font-size: 14px;
    }

    .slider-nav {
      width: 40px;
      height: 40px;
    }

    .slider-nav.prev {
      left: 15px;
    }

    .slider-nav.next {
      right: 15px;
    }
  }

  @media (max-width: 480px) {
    .banner-slider-wrapper {
      height: {{ section.settings.mobile_height | times: 0.8 }}px;
    }

    .slide-header {
      font-size: {{ section.settings.header_size | times: 0.6 }}px;
    }

    .slide-description {
      font-size: {{ section.settings.description_size | times: 0.8 }}px;
    }

    .container {
      padding: 0 15px;
    }
  }
</style>

<script>
  (function() {
    let currentSlide{{ section.id }} = 0;
    let totalSlides{{ section.id }} = {{ section.blocks.size }};
    let autoplayInterval{{ section.id }};

    // Change slide function
    window.changeSlide{{ section.id }} = function(direction) {
      const slides = document.querySelectorAll('#bannerSlider{{ section.id }} .slide');
      const dots = document.querySelectorAll('#pagination{{ section.id }} .pagination-dot');
      
      // Remove active class from current slide and dot
      slides[currentSlide{{ section.id }}].classList.remove('active');
      if (dots[currentSlide{{ section.id }}]) {
        dots[currentSlide{{ section.id }}].classList.remove('active');
      }
      
      // Calculate new slide index
      currentSlide{{ section.id }} += direction;
      
      // Handle loop
      if (currentSlide{{ section.id }} >= totalSlides{{ section.id }}) {
        currentSlide{{ section.id }} = 0;
      }
      if (currentSlide{{ section.id }} < 0) {
        currentSlide{{ section.id }} = totalSlides{{ section.id }} - 1;
      }
      
      // Add active class to new slide and dot
      slides[currentSlide{{ section.id }}].classList.add('active');
      if (dots[currentSlide{{ section.id }}]) {
        dots[currentSlide{{ section.id }}].classList.add('active');
      }
      
      // Restart autoplay
      {% if section.settings.autoplay %}
      restartAutoplay{{ section.id }}();
      {% endif %}
    };

    // Go to specific slide
    window.goToSlide{{ section.id }} = function(slideIndex) {
      const slides = document.querySelectorAll('#bannerSlider{{ section.id }} .slide');
      const dots = document.querySelectorAll('#pagination{{ section.id }} .pagination-dot');
      
      // Remove active class from current slide and dot
      slides[currentSlide{{ section.id }}].classList.remove('active');
      if (dots[currentSlide{{ section.id }}]) {
        dots[currentSlide{{ section.id }}].classList.remove('active');
      }
      
      // Set new slide
      currentSlide{{ section.id }} = slideIndex;
      
      // Add active class to new slide and dot
      slides[currentSlide{{ section.id }}].classList.add('active');
      if (dots[currentSlide{{ section.id }}]) {
        dots[currentSlide{{ section.id }}].classList.add('active');
      }
      
      // Restart autoplay
      {% if section.settings.autoplay %}
      restartAutoplay{{ section.id }}();
      {% endif %}
    };

    {% if section.settings.autoplay %}
    // Autoplay functions
    function startAutoplay{{ section.id }}() {
      autoplayInterval{{ section.id }} = setInterval(function() {
        changeSlide{{ section.id }}(1);
      }, {{ section.settings.autoplay_speed }}000);
    }

    function stopAutoplay{{ section.id }}() {
      if (autoplayInterval{{ section.id }}) {
        clearInterval(autoplayInterval{{ section.id }});
      }
    }

    function restartAutoplay{{ section.id }}() {
      stopAutoplay{{ section.id }}();
      startAutoplay{{ section.id }}();
    }

    // Start autoplay when page loads
    document.addEventListener('DOMContentLoaded', function() {
      startAutoplay{{ section.id }}();
      
      // Pause autoplay on hover
      const slider = document.getElementById('bannerSlider{{ section.id }}');
      if (slider) {
        slider.addEventListener('mouseenter', stopAutoplay{{ section.id }});
        slider.addEventListener('mouseleave', startAutoplay{{ section.id }});
      }
    });
    {% endif %}

    // Keyboard navigation
    document.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowLeft') {
        changeSlide{{ section.id }}(-1);
      } else if (e.key === 'ArrowRight') {
        changeSlide{{ section.id }}(1);
      }
    });

    // Touch/swipe support
    let touchStartX = 0;
    let touchEndX = 0;

    const slider = document.getElementById('bannerSlider{{ section.id }}');
    if (slider) {
      slider.addEventListener('touchstart', function(e) {
        touchStartX = e.changedTouches[0].screenX;
      });

      slider.addEventListener('touchend', function(e) {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
      });

      function handleSwipe() {
        const swipeThreshold = 50;
        const diff = touchStartX - touchEndX;
        
        if (Math.abs(diff) > swipeThreshold) {
          if (diff > 0) {
            // Swiped left - go to next slide
            changeSlide{{ section.id }}(1);
          } else {
            // Swiped right - go to previous slide
            changeSlide{{ section.id }}(-1);
          }
        }
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Full Width Banner Slider",
  "settings": [
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "range",
      "id": "slider_height",
      "min": 400,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Desktop Height",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 300,
      "max": 600,
      "step": 25,
      "unit": "px",
      "label": "Mobile Height",
      "default": 450
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Speed",
      "default": 5
    },
    {
      "type": "header",
      "content": "Background & Overlay"
    },
    {
      "type": "color",
      "id": "bg_color_1",
      "label": "Fallback Gradient Start",
      "default": "#8B5CF6"
    },
    {
      "type": "color",
      "id": "bg_color_2",
      "label": "Fallback Gradient End",
      "default": "#A855F7"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "%",
      "label": "Image Overlay Opacity",
      "default": 30
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "header_size",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Header Font Size",
      "default": 48
    },
    {
      "type": "color",
      "id": "header_color",
      "label": "Header Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size",
      "default": 18
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Button Styling"
    },
    {
      "type": "color",
      "id": "button_bg_1",
      "label": "Button Gradient Start",
      "default": "#F97316"
    },
    {
      "type": "color",
      "id": "button_bg_2",
      "label": "Button Gradient End",
      "default": "#EA580C"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Button Border Radius",
      "default": 25
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "color",
      "id": "navigation_color",
      "label": "Arrow Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "pagination_active_color",
      "label": "Active Dot Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "banner_image",
          "label": "Background Image"
        },
        {
          "type": "text",
          "id": "header",
          "label": "Header Text",
          "default": "FULL WRAP BOTTLE PRINTING"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description Text",
          "default": "WITH AN MOQ OF 15!"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Full Width Banner Slider",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}