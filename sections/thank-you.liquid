<div class="padding-global" data-thank-you-section>
  <div class="container-large">
    <div class="padding-section-large">
      <div class="thank-you-wrapper">
        <div class="w-layout-grid thank-you-grid">
          <div class="thank-you-des">
            <h1 class="heading-style-h2">{{ section.settings.heading }}</h1>
            <div class="thank-you-content richtext-wrapper text-size-medium w-richtext">{{ section.settings.description }}</div>
          </div>
          <div id="book-meeting" class="thank-you-meeting thank-you-meeting--hidden" data-booking-form>
            {{ section.settings.liquid }}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    var section = document.querySelector('[data-thank-you-section]');
    var form = document.querySelector('[data-booking-form]');
    if (section && form) {
      section.addEventListener('click', function(e) {
        if (e.target.closest('a[href="#book-meeting"]')) {
          e.preventDefault();
          form.classList.remove('thank-you-meeting--hidden');
          form.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }
  })();
</script>

<style>
.thank-you-grid {
  grid-column-gap: 5rem;
  grid-row-gap: 4rem;
  grid-template-rows: auto;
  grid-template-columns: 1fr 1fr;
  grid-auto-columns: 1fr;
  align-items: start;
}
.thank-you-des h1 {
  margin-top: 0;
  margin-bottom: 1.5rem;
}
.thank-you-content ul {
  list-style: none;
  padding-left: 0;
  margin: 1.5em 0;
}
.thank-you-content ul li {
  margin-bottom: 0.75em;
  padding-left: 1.5em;
  position: relative;
}
.thank-you-content ul li::before {
  content: "–";
  position: absolute;
  left: 0;
}
.thank-you-content a[href="#book-meeting"] {
  display: inline-block;
  margin-top: 0.5em;
  padding: 0.6em 1.25em;
  background: var(--base-color-brand--orange, #f66718);
  color: white;
  text-decoration: none;
  border-radius: var(--border-radius--small, 1.25rem);
  font-weight: 600;
  transition: opacity 0.2s;
}
.thank-you-content a[href="#book-meeting"]:hover {
  opacity: 0.9;
  color: white;
}
.thank-you-meeting--hidden {
  display: none !important;
}

@media screen and (max-width: 991px) {
  .thank-you-grid {
    grid-column-gap: 3rem;
    grid-template-columns: 1fr 1fr;
  }
}

@media screen and (max-width: 767px) {
  .thank-you-grid {
    grid-row-gap: 3rem;
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
    "name": "Thank You",
    "tag": "section",
    "class": "thank-you-section",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description"
        },
        {
            "type": "liquid",
            "id": "liquid",
            "label": "Embed snippet"
        }
    ],
    "presets": [
        {
            "name": "Thank You"
        }
    ]
}
{% endschema %}
