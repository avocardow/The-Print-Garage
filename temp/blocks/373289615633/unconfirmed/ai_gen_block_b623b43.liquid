{% doc %}
  @prompt
    custom liquid section so I can embed 3rd party snippet

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-liquid-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    max-width: 100%;
    overflow-x: auto;
  }

  .ai-custom-liquid-content-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-custom-liquid-placeholder-{{ ai_gen_id }} {
    background-color: #f8f9fa;
    border: 2px dashed #dee2e6;
    border-radius: 8px;
    padding: 40px 20px;
    text-align: center;
    color: #6c757d;}

  .ai-custom-liquid-placeholder-icon-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    margin: 0 auto 16px;
    opacity: 0.5;
  }

  .ai-custom-liquid-placeholder-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 8px;
    color: #495057;
  }

  .ai-custom-liquid-placeholder-text-{{ ai_gen_id }} {
    font-size: 14px;
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-custom-liquid-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }
  }
{% endstyle %}<div
  class="ai-custom-liquid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-custom-liquid-content-{{ ai_gen_id }}">
    {% if block.settings.custom_liquid != blank %}
      {{ block.settings.custom_liquid }}
    {% else %}
      <div class="ai-custom-liquid-placeholder-{{ ai_gen_id }}"><div class="ai-custom-liquid-placeholder-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
        </div>
        <h3 class="ai-custom-liquid-placeholder-title-{{ ai_gen_id }}">Custom Liquid Code</h3>
        <p class="ai-custom-liquid-placeholder-text-{{ ai_gen_id }}">
          Add your custom Liquid code or third-party snippets in the block settings below
        </p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Custom liquid",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid code"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Custom liquid"
    }
  ]
}
{% endschema %}